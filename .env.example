# Family Ops — project-level secrets template.
#
# v6 review fix (P1-D, this round): this project-root .env is the source of
# truth for values `supabase/config.toml` itself reads via env(...)
# references (previously templated at supabase/.env.example, one level
# down — moved here so local dev and CI load exactly one file the same
# way). This is NOT Edge Function runtime secrets — those stay separate at
# supabase/functions/.env.example, since they're read by the Deno runtime
# via `supabase secrets set`/`--env-file`, not by the CLI's own config.toml
# parsing.
#
# Usage: `cp .env.example .env`, fill in real values, never commit `.env`
# (already gitignored), then before any `supabase` CLI command:
#   set -a && source .env && set +a
# supabase config.toml's env(...) substitution reads from the process
# environment, not from any dotenv file it loads on its own — sourcing
# explicitly is what makes this file authoritative rather than aspirational.
# scripts/run_supabase_integration_tests.sh's caller (CI and local) does
# this for you; see .github/workflows/ci.yml's supabase-integration job.

# Supabase Auth's own Google Sign-In provider (PWA login / onboarding).
# Distinct from the separate Google Calendar OAuth client used by
# google-calendar-oauth-start/-callback — see docs/design/v6/01_ARCHITECTURE.md
# and docs/design/v6/14_EXTERNAL_SETUP_STEPS.md #3 "App Google Sign-In".
GOOGLE_SIGNIN_CLIENT_ID=
GOOGLE_SIGNIN_CLIENT_SECRET=

# This is the Google -> Supabase Auth (GoTrue) OAuth callback — register it
# verbatim in the Google Cloud Console's "Authorized redirect URIs" for the
# Web client used here. It is NOT the app's own post-login landing page
# (that's the PWA's `redirectTo`, already covered by [auth] site_url /
# additional_redirect_urls in supabase/config.toml and never read from this
# file). The local Supabase CLI stack always serves GoTrue at
# 127.0.0.1:54321, so this value is fixed for local dev; a hosted project
# uses its own project ref's Auth URL instead.
GOOGLE_SIGNIN_CALLBACK_URL=http://127.0.0.1:54321/auth/v1/callback
