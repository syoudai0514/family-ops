# Family Ops Edge Function secrets template (WP0/WP1)
# Set real values with: supabase secrets set --env-file supabase/functions/.env.local
# Never commit supabase/functions/.env.local or any real secret value.
# Variable names follow docs/design/v6/ENV_TEMPLATE.md exactly.

# Google Calendar OAuth - separate from Supabase Auth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# 32-byte base64 key for AES-256-GCM refresh-token envelope
TOKEN_ENCRYPTION_KEY_V1=

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

GEMINI_API_KEY=
GEMINI_MODEL_PARSE=
GEMINI_MODEL_REWRITE=
AI_MODE=free_lightweight

APP_BASE_URL=

# 256-bit random shared only by Supabase Vault cron caller and worker Edge Functions
CRON_WORKER_TOKEN=

# Runtime defaults / policy
LINE_INBOX_LEASE_SECONDS=300
NOTIFICATION_LEASE_SECONDS=300
GOOGLE_SYNC_LEASE_SECONDS=600
PENDING_ACTION_LEASE_SECONDS=300

QUEUE_MAX_ATTEMPTS=8
PENDING_ACTION_MAX_ATTEMPTS=5

GOOGLE_STALE_ON_APP_OPEN_MINUTES=15
GOOGLE_PERIODIC_SYNC_MINUTES=30
GOOGLE_WATCH_RENEW_WITHIN_HOURS=24
GOOGLE_OCCURRENCE_PAST_DAYS=7
GOOGLE_OCCURRENCE_FUTURE_DAYS=60
WEEKLY_DIGEST_CALENDAR_STALE_WARNING_MINUTES=60
WEEKLY_DIGEST_PREFLIGHT_MINUTES=10

RAW_INPUT_TTL_HOURS=24

# v6 review fix (P1-1): weekly_digest / Sunday 12:00 is retired as a
# schedule_kind — Sunday's next-week bundle is carried inside
# nonworkday_morning_digest instead. DEFAULT_WEEKLY_DIGEST_WEEKDAY/TIME are
# intentionally not present here; WEEKLY_DIGEST_PREFLIGHT_MINUTES above is
# unrelated internal worker logic (Sunday 09:00 section preflight), not this
# retired schedule.
DEFAULT_DAILY_ASSIGNMENT_TIME=07:00
DEFAULT_DROPOFF_CHECKLIST_TIME=07:00
DEFAULT_DROPOFF_CHECKIN_TIME=08:30
DEFAULT_PICKUP_CHECKLIST_TIME=16:00
DEFAULT_NONPICKUP_EVENING_CHECKLIST_TIME=20:00
DEFAULT_PICKUP_CHECKIN_TIME=20:30
DEFAULT_NONPICKUP_EVENING_CHECKIN_TIME=22:00

# v6 quota/config — Family Ops-side hard cap, independent of provider plan changes
LINE_QUOTA_SOFT_BUDGET=180
LINE_QUOTA_CRITICAL_RESERVE=20
LINE_QUOTA_REFRESH_MINUTES=15
FAMILY_OPS_TIMEZONE=Asia/Tokyo
APP_LINE_MONTHLY_HARD_CAP=200
LINE_RETRY_KEY_SAFETY_HOURS=23
EDGE_INVOCATION_WARN_THRESHOLD=350000
EDGE_INVOCATION_INVESTIGATE_THRESHOLD=400000
JP_HOLIDAY_CSV_URL=https://www8.cao.go.jp/chosei/shukujitsu/syukujitsu_kyujitsu.csv

# Never set client-side (VITE_*): service role key, DB password, Google client
# secret/refresh token, TOKEN_ENCRYPTION_KEY, CRON_WORKER_TOKEN, LINE channel
# secret/access token, Gemini key, R2 credentials.
