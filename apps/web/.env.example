# Family Ops web app — environment template (WP0)
# Copy to .env.local for local development. Never commit real secrets.
# Variable names follow docs/design/v6/ENV_TEMPLATE.md exactly.

# Supabase project URL and publishable (anon) key.
# These are safe to expose to the browser bundle — RLS enforces access control.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_APP_NAME=Family Ops
VITE_APP_BASE_URL=http://localhost:5173
