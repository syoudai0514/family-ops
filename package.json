{
  "name": "family-ops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "test": "npm run test -w apps/web",
    "test:sql": "bash scripts/run_sql_tests.sh",
    "test:cf14:authoring": "node --test tests/evidence/cf14/*.test.mjs",
    "test:cf14:browser": "node scripts/run_cf14_browser_e2e.mjs",
    "test:cf14:f2": "node scripts/run_cf14_f2.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
